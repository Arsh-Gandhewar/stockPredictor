# ==============================================================
# STOCK PREDICTOR - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================
# IMPORTANT: Copy this file to `.env` and fill in your actual values.
# Do NOT commit your `.env` file to version control.

# --------------------------------------------------------------
# DATABASE (Prisma / PostgreSQL)
# --------------------------------------------------------------
# Connection string for your PostgreSQL database.
DATABASE_URL="postgresql://johndoe:mypassword@localhost:5432/stock_db?schema=public"

# --------------------------------------------------------------
# CLERK AUTHENTICATION (Next.js & NestJS)
# --------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Webhook secret for syncing Clerk users with the PostgreSQL DB
CLERK_WEBHOOK_SECRET="whsec_..."

# --------------------------------------------------------------
# REDIS (BullMQ)
# --------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# --------------------------------------------------------------
# GOOGLE GEMINI AI
# --------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
# Default models to use
GEMINI_MODEL="gemini-1.5-pro-latest"
GEMINI_FLASH_MODEL="gemini-1.5-flash-latest"

# --------------------------------------------------------------
# EXTERNAL APIS (Stock Data & News)
# --------------------------------------------------------------
# If you are using a paid provider instead of yahoo-finance2
# ALPHA_VANTAGE_API_KEY=""
# NEWS_API_KEY=""

# --------------------------------------------------------------
# BACKEND SERVER CONFIGURATION
# --------------------------------------------------------------
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
