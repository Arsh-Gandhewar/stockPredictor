# === QuantX Environment Variables ===

# Database (PostgreSQL via Neon/Prisma)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key"

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server
PORT=3001

# QuantX MCP Server
QUANTX_API_URL=http://127.0.0.1:3001
QUANTX_API_KEY=your-mcp-api-key
MCP_SERVER_NAME=quantx-mcp
MCP_LOG_LEVEL=info
MCP_REQUEST_TIMEOUT_MS=10000
MCP_AUTH_USER_ID=default_user
