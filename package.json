{
  "name": "stock-predictor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run generate --workspace=packages/db && npm run build --workspace=packages/db && npm run build --workspace=apps/api",
    "build:all": "npm run build --workspaces --if-present",
    "start": "node apps/api/dist/main.js",
    "lint": "npm run lint --workspaces --if-present",
    "mcp:start": "npm run start --prefix apps/mcp-server",
    "mcp:start:prod": "npm run start:prod --prefix apps/mcp-server",
    "mcp:dev": "npm run dev --prefix apps/mcp-server",
    "mcp:build": "npm run build --prefix apps/mcp-server",
    "mcp:test": "npm run test --prefix apps/mcp-server",
    "mcp:eng:start": "npm run start --prefix apps/mcp-engineering",
    "mcp:eng:dev": "npm run dev --prefix apps/mcp-engineering",
    "mcp:eng:build": "npm run build --prefix apps/mcp-engineering",
    "mcp:eng:test": "npm run test --prefix apps/mcp-engineering",
    "sync:manifests": "node scripts/sync-manifests.js",
    "verify:manifests": "node scripts/sync-manifests.js --verify",
    "verify:evidence": "node scripts/verify-test-evidence.js",
    "generate:economic": "node scripts/generate-economic-certification.js",
    "verify:economic": "node scripts/verify-economic-certification.js"
  }
}
