generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  clerkId    String      @unique
  email      String      @unique
  firstName  String?
  lastName   String?
  avatarUrl  String?
  role       Role        @default(USER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  alerts     Alert[]
  portfolio  Portfolio?
  watchlists Watchlist[]
}

model Stock {
  id                  String               @id @default(cuid())
  ticker              String               @unique
  name                String
  exchange            String
  sector              String?
  industry            String?
  description         String?
  logoUrl             String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiInsights          AIInsight[]
  alerts              Alert[]
  fundamentalData     FundamentalData?
  news                NewsArticleOnStock[]
  positions           Position[]
  priceHistory        PriceHistory[]
  technicalIndicators TechnicalIndicator[]
  transactions        Transaction[]
  watchlistStocks     WatchlistStock[]

  @@index([sector])
  @@index([isActive])
}

model PriceHistory {
  id        String   @id @default(cuid())
  stockId   String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    BigInt
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, date])
  @@index([stockId])
  @@index([date])
}

model TechnicalIndicator {
  id             String   @id @default(cuid())
  stockId        String
  timestamp      DateTime
  rsi            Float?
  macd           Float?
  macdSignal     Float?
  macdHist       Float?
  ema20          Float?
  sma50          Float?
  sma200         Float?
  bollingerUpper Float?
  bollingerLower Float?
  atr            Float?
  adx            Float?
  vwap           Float?
  obv            Float?
  createdAt      DateTime @default(now())
  stock          Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, timestamp])
  @@index([stockId])
}

model FundamentalData {
  id                   String   @id @default(cuid())
  stockId              String   @unique
  peRatio              Float?
  pbRatio              Float?
  roe                  Float?
  roce                 Float?
  eps                  Float?
  debtEquity           Float?
  bookValue            Float?
  dividendYield        Float?
  promoterHolding      Float?
  institutionalHolding Float?
  marketCap            BigInt?
  updatedAt            DateTime @updatedAt
  stock                Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id           String               @id @default(cuid())
  source       String
  title        String
  url          String               @unique
  publishTime  DateTime
  author       String?
  summary      String?
  sentiment    Sentiment
  confidence   Float?
  impactShort  String?
  impactLong   String?
  whyItMatters String?
  createdAt    DateTime             @default(now())
  stocks       NewsArticleOnStock[]
}

model NewsArticleOnStock {
  newsId  String
  stockId String
  news    NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  stock   Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@id([newsId, stockId])
  @@index([stockId])
}

model AIInsight {
  id               String         @id @default(cuid())
  stockId          String
  recommendation   Recommendation
  confidenceScore  Float
  reasoning        String
  riskLevel        RiskLevel
  bullishFactors   String[]
  bearishFactors   String[]
  expectedTrend    String
  horizon          Horizon
  entryZoneLow     Float?
  entryZoneHigh    Float?
  target           Float?
  stopLoss         Float?
  rewardRiskRatio  Float?
  probabilityScore Float?
  timestamp        DateTime       @default(now())
  stock            Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([timestamp])
}

model Portfolio {
  id            String        @id @default(cuid())
  userId        String        @unique
  availableCash Float         @default(1000000)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions     Position[]
  transactions  Transaction[]
}

model Position {
  id           String    @id @default(cuid())
  portfolioId  String
  stockId      String
  quantity     Int
  averagePrice Float
  updatedAt    DateTime  @updatedAt
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  stock        Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, stockId])
  @@index([stockId])
}

model Transaction {
  id          String          @id @default(cuid())
  portfolioId String
  stockId     String
  type        TransactionType
  orderType   OrderType
  quantity    Int
  price       Float
  timestamp   DateTime        @default(now())
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  stock       Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([stockId])
  @@index([timestamp])
}

model Alert {
  id          String          @id @default(cuid())
  userId      String
  stockId     String
  type        AlertType
  condition   Condition
  targetValue Float?
  targetRec   Recommendation?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  triggeredAt DateTime?
  stock       Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stockId])
  @@index([stockId, isActive])
}

model Watchlist {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks    WatchlistStock[]

  @@unique([userId, name])
}

model WatchlistStock {
  watchlistId String
  stockId     String
  isPinned    Boolean   @default(false)
  notes       String?
  colorLabel  String?
  addedAt     DateTime  @default(now())
  stock       Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@id([watchlistId, stockId])
  @@index([stockId])
}

enum Role {
  USER
  ADMIN
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Recommendation {
  STRONG_BUY
  BUY
  ACCUMULATE
  HOLD
  REDUCE
  SELL
  STRONG_SELL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Horizon {
  SWING
  SHORT_TERM
  LONG_TERM
}

enum TransactionType {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum AlertType {
  PRICE
  VOLUME
  NEWS
  AI_RECOMMENDATION_CHANGE
  TARGET_HIT
  STOP_LOSS_HIT
}

enum Condition {
  GREATER_THAN
  LESS_THAN
  EQUALS
  CHANGES_TO
}
