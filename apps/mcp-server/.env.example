# QuantX MCP Server Environment Configuration
# NEVER commit real credentials, tokens, or API keys to version control.

# Required: URL pointing to the QuantX NestJS API Gateway (default port 3001)
QUANTX_API_URL=http://127.0.0.1:3001

# Required: Secret API key for backend communication
QUANTX_API_KEY=your_quantx_api_secret_key_here

# Optional: Server identification
MCP_SERVER_NAME=quantx-mcp
MCP_SERVER_VERSION=1.0.0

# Optional: Logging verbosity (debug | info | warn | error) - logs always write to STDERR
MCP_LOG_LEVEL=info

# Optional: Request timeout in milliseconds (default: 10000ms = 10s)
MCP_REQUEST_TIMEOUT_MS=10000

# Optional: Default user context ID for paper trading / portfolio requests
MCP_AUTH_USER_ID=default_user
